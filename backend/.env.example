# =============================================================================
# Comexa backend — variables d'environnement
# =============================================================================
# Copier ce fichier en `.env` puis remplacer chaque valeur.
#
#     cp backend/.env.example backend/.env
#
# `.env` est ignore par git (voir .gitignore). CE FICHIER-CI, non : il ne doit
# jamais contenir de secret, seulement des exemples.
#
# Generer un secret solide :
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api
# --- Limitation de debit (anti-abus) -----------------------------------------
# Fenetre glissante, par adresse IP : `limit` requetes par `ttl` millisecondes.
# Les valeurs ci-dessous sont celles d'avant le reglage : mettre a jour ne change
# rien au comportement. A resserrer si l'API est balayee, a desserrer si un
# workflow n8n bavard atteint le plafond (il recoit alors des 429).
# Le compteur suit `request.ip`, donc `TRUST_PROXY` : derriere un reverse proxy
# sans ce reglage, TOUS les clients partagent un seul compteur.
RATE_LIMIT_LIMIT=120
RATE_LIMIT_TTL=60000
# Origines autorisees a appeler l'API, separees par des virgules.
# En dev, le frontend Next tourne sur 3000.
CORS_ORIGIN=http://localhost:3000
# Confiance accordee aux en-tetes X-Forwarded-*, donc a request.ip.
# VIDE OU false = comportement historique : l'adresse du client est lue dans
#   x-forwarded-for, ce qui est juste derriere un proxy et falsifiable sans proxy.
# 1 = derriere UN reverse proxy. C'est le reglage recommande en production :
#   sans lui, le limiteur de debit global compte toutes les requetes sous
#   l'adresse du proxy et finit par repondre 429 a tout le monde.
# true = a eviter. L'application doit alors n'etre joignable QUE par le proxy,
#   sinon un client forge une adresse par requete et echappe au limiteur.
# Accepte aussi une liste : loopback, linklocal, uniquelocal, IP ou plage CIDR.
TRUST_PROXY=false

# --- Base de donnees (PostgreSQL / Neon) -------------------------------------
# DATABASE_URL : connexion POOLISEE, utilisee par l'application au runtime.
# DIRECT_URL   : connexion DIRECTE, utilisee par les MIGRATIONS.
# Sur Neon, l'hote pooli contient "-pooler". Les migrations DDL passent mal par
# un pooler en mode transaction : Prisma utilise donc DIRECT_URL pour elles.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentification (JWT) --------------------------------------------------
# Deux secrets DIFFERENTS. Ne jamais les reutiliser ni les committer.
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-48-octets
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=remplacer-par-un-autre-secret-aleatoire-de-48-octets
JWT_REFRESH_TTL=30d

# --- URL publique du frontend (liens dans les courriels) ---------------------
FRONTEND_URL=http://localhost:3000

# --- Stockage des fichiers ---------------------------------------------------
# driver : "local" en developpement, "s3" en production.
# Les fichiers binaires ne vont JAMAIS dans PostgreSQL : la base ne conserve
# que les metadonnees et la cle de stockage (voir modele Document).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Renseigner uniquement si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Limites -----------------------------------------------------------------
# Taille maximale d'un envoi de fichier, en octets (25 Mo).
MAX_UPLOAD_BYTES=26214400

# --- Documentation OpenAPI (production) --------------------------------------
# La documentation est le plan complet de l'API : ses 165 operations, ses
# modeles, ses codes de permission. Elle est FERMEE en production par defaut, et
# elle le reste tant que personne ne l'ouvre ici. Hors production, elle est
# servie sans protection : elle sert au frontend de developpement, et exiger un
# mot de passe pour lire une API qui tourne sur localhost ne protegerait rien.
#
# DOCS_ENABLED EST UNE CHAINE, ET NON UN BOOLEEN, volontairement : `validateEnv`
# s'execute avec `enableImplicitConversion`, ou la chaine "false" devient `true`
# -- l'inverse exact de la demande. Un champ booleen ici ouvrirait donc la
# documentation sur un deploiement qui a pourtant ecrit « false ».
#
# Valeurs acceptees : false (le defaut), true, 0, 1, no, yes, off, on.
# TOUTE AUTRE VALEUR ARRETE LE DEMARRAGE. C'est voulu : quelqu'un qui ecrit
# « oui » a l'intention d'OUVRIR la documentation, et un repli silencieux vers
# `false` l'enverrait chercher la panne du cote du reseau ou du cache, tres loin
# de la variable qu'il vient de poser.
#
# OUVRIR LA DOCUMENTATION EXIGE DE LA PROTEGER. En production, DOCS_ENABLED=true
# sans DOCS_USER et DOCS_PASSWORD ARRETE LE DEMARRAGE, pour la meme raison que le
# refus courriel plus bas : une configuration incomplete doit arreter le
# processus, pas se decouvrir en ligne. Sans ce controle, le serveur demarrerait,
# servirait le plan complet de l'API a quiconque connait l'URL, et RIEN ne le
# signalerait.
#
# LE MOT DE PASSE DOIT FAIRE AU MOINS 16 CARACTERES, et ce n'est pas une
# coquetterie : les routes de Swagger ne passent PAS par le limiteur de debit
# (celui-ci est un garde de Nest, et Swagger monte ses routes directement sur
# l'adaptateur HTTP, hors du routeur). Rien ne borne donc le nombre d'essais, et
# seule la longueur du secret protege encore. En generer un avec :
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# COMMENT ON SAISIT CES IDENTIFIANTS. /api/docs sert une PAGE DE CONNEXION
# rendue par le serveur : ouvrir l'adresse dans n'importe quel navigateur, s'y
# identifier, et rien de plus. Pas de fenetre privee, pas de cache a vider, pas
# de dialogue natif a faire revenir. La page est du HTML ordinaire SANS
# JavaScript — helmet pose `script-src 'self'`, donc un `<script>` en ligne serait
# bloque — et son formulaire poste sur `/api/docs-login`.
#
# L'AUTHENTIFICATION HTTP BASIC RESTE ACCEPTEE sur les memes adresses, parce que
# les clients qui ne sont pas des navigateurs en ont besoin :
#
#   curl -u "$DOCS_USER:$DOCS_PASSWORD" https://api.exemple.tld/api/docs-yaml
#
# Un client qui n'annonce pas de HTML — `curl`, Postman, un script — recoit un
# 401 avec `WWW-Authenticate`. C'est le seul cas ou cette invite apparait encore :
# un navigateur, lui, recoit la page de connexion. Une requete Basic reussie
# n'ouvre aucune session, il n'y a donc pas de cookie a conserver.
#
# UNE CONNEXION RATEE PAR LE FORMULAIRE REPOND 200, ET NON 401. Ce n'est pas une
# negligence : un 401 accompagne de `WWW-Authenticate` ferait apparaitre l'invite
# native PAR-DESSUS le message d'erreur de la page, ce qui ramene exactement le
# probleme que cette page resout. L'echec se lit dans la page.
#
# Une connexion reussie pose un cookie signe (HMAC-SHA256, 7 jours), HttpOnly,
# Secure, SameSite=Lax. Il est pose sur les trois chemins `/api/docs`,
# `/api/docs-json` et `/api/docs-yaml`, qui sont des freres et non des enfants —
# un cookie pose sur le seul premier ne couvrirait pas les deux autres.
#
# CHANGER `DOCS_PASSWORD` INVALIDE TOUTES LES SESSIONS : la cle qui signe les
# cookies derive du mot de passe. C'est aussi la facon de couper un acces deja
# donne, sans se souvenir de qui l'a recu.
#
# Ces deux valeurs sont lues par le serveur, jamais journalisees, et ne figurent
# pas dans le document OpenAPI.
DOCS_ENABLED=false
DOCS_USER=
DOCS_PASSWORD=

# --- Courriel transactionnel -------------------------------------------------
# DEUX CHEMINS, ET L'UN DES DEUX EST OBLIGATOIRE EN PRODUCTION : le serveur
# refuse de demarrer si ni le couple `MAILJET_API_KEY` + `MAILJET_SECRET_KEY` ni
# `SMTP_HOST` n'est renseigne.
#
# UNE SEULE EXCEPTION, ET ELLE EST EXPLICITE : `ALLOW_BOOT_WITHOUT_MAIL=true`
# (declare plus bas, dans cette section) leve ce refus, pour permettre de
# deployer le reste du backend avant d'avoir un compte chez un fournisseur, en
# sachant que les courriels ne partiront pas.
#
# Pourquoi un refus et non un avertissement : le parcours « mot de passe
# oublie » repond toujours 200, meme sur une adresse inconnue, pour ne pas
# reveler quels comptes existent. Cette reponse n'est honnete que si le courriel
# part quand le compte existe. Sans transport, tout le monde lit « consultez
# votre boite » et personne ne recoit rien.
#
# En developpement, laisser les deux vides : le lien de reinitialisation est
# alors ecrit dans les journaux du serveur, ce qui suffit pour tester.
#
# -----------------------------------------------------------------------------
# 1. MAILJET_API_KEY + MAILJET_SECRET_KEY — API HTTP, port 443.
#    LE CHEMIN QUI FONCTIONNE PARTOUT.
# -----------------------------------------------------------------------------
# A utiliser en priorite. Plusieurs hebergeurs gratuits bloquent en sortie les
# ports SMTP 25, 465 et 587 (c'est le cas de l'offre gratuite de Render depuis
# le 26/09/2025) : sur ces plateformes, SMTP_HOST ne renvoie pas une erreur
# d'authentification, la connexion n'aboutit simplement jamais. Le port 443, lui,
# n'est jamais filtre : c'est celui par lequel l'API repond.
#
# POURQUOI DEUX VARIABLES ET NON UNE. Mailjet authentifie en HTTP Basic : la cle
# publique sert d'identifiant, la cle secrete de mot de passe. Il n'existe pas de
# forme condensee, et fournir une seule des deux donne un 401 a CHAQUE envoi. Le
# serveur refuse donc de demarrer sur un couple incomplet, en nommant celle qui
# manque plutot qu'en annoncant « aucun moyen d'envoi ».
#
# OU TROUVER LES DEUX CLES : Mailjet, « Account Settings » puis « API Key
# Management ». Ce ne sont PAS les identifiants SMTP du meme ecran : ceux-la vont
# dans SMTP_USER et SMTP_PASSWORD, plus bas, et ne conviennent pas ici.
#
# DEUX CHOSES QUI FONT PERDRE DU TEMPS AU PREMIER ENVOI, ET QUI NE SE VOIENT PAS
# DANS LES JOURNAUX :
#   * l'adresse de `SMTP_FROM` doit etre un EXPEDITEUR VALIDE chez Mailjet
#     (« Sender domains & addresses »), valide en cliquant le lien envoye a cette
#     boite. Sinon l'envoi est refuse — et, piege de leur API, ce refus arrive
#     parfois sous un HTTP 200 : c'est le corps de la reponse qui porte le rejet,
#     jamais le code HTTP.
#   * un compte neuf reste en « Test Mode » (10 courriels par heure) jusqu'a la
#     validation manuelle du compte par Mailjet. Le palier gratuit plafonne par
#     ailleurs a 200 courriels par jour, et DEPASSER CE PLAFOND NE PRODUIT AUCUNE
#     ERREUR : les courriels au-dela sont abandonnes en silence.
#
# PRECEDENCE : si le couple et SMTP_HOST sont renseignes, l'API HTTP gagne. Le
# choix se fait par la presence des identifiants, il n'y a pas de variable a
# positionner.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# -----------------------------------------------------------------------------
# 2. SMTP_HOST — relais SMTP. Necessaire seulement si l'API n'est pas utilisee.
# -----------------------------------------------------------------------------
# Le port 465 active TLS implicite, les autres (587, 25) demarrent en clair puis
# passent en STARTTLS. Ce choix est deduit du port, il n'y a rien a preciser.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Expediteur des deux transports. Format « Nom <adresse> » ou « adresse » seule.
# L'API HTTP le decompose en deux champs, le SMTP le recompose en en-tete : une
# seule valeur, donc, pour les deux chemins.
SMTP_FROM="Comexa <no-reply@comexa.example>"

# Derogation explicite au refus de demarrer sans moyen d'envoi.
#
# A LAISSER A `false` des qu'un transport est configure. Elle existe pour une
# seule raison : permettre de deployer le backend — y compris les parties qui
# n'ont aucun rapport avec le courriel — avant d'avoir un compte chez un
# fournisseur d'envoi.
#
# CE QU'ELLE COUTE QUAND ELLE EST OUVERTE : « mot de passe oublie » repond 200
# sans rien expedier, et chaque courriel non envoye est recopie dans les
# journaux sous une banniere. Le serveur ecrit aussi un avertissement au
# demarrage, en precisant qu'il tourne en production.
#
# ECRIRE `false` OU `true`, PAS `0` NI `1` : les deux formes chiffrees sont
# acceptees, mais une valeur non reconnue (« oui », « vrai ») fait ECHOUER le
# demarrage avec un message qui nomme la variable. C'est volontaire — un repli
# silencieux fermerait la derogation sans le dire.
ALLOW_BOOT_WITHOUT_MAIL=false

# Duree de vie d'un lien de reinitialisation de mot de passe (1h par defaut).
PASSWORD_RESET_TTL=1h

# Duree de vie d'un lien de verification d'adresse e-mail (24h par defaut).
# Un compte cree par inscription libre reste inactif tant que le lien n'est pas suivi.
EMAIL_VERIFICATION_TTL=24h

# Moyens de paiement acceptes pour une commande, par devise. Liste separee par des
# virgules. VIDE PAR DEFAUT : tant que PAYMENT_METHODS_DZD n'est pas renseigne, les
# clients algeriens ne peuvent pas commander en ligne (demande de projet a la place).
# Valeurs : BANK_TRANSFER, CARD, CASH, CHECK, PAYPAL, OTHER. Une valeur inconnue fait
# echouer le demarrage, en nommant la variable.
PAYMENT_METHODS_DZD=
PAYMENT_METHODS_EUR=

# =============================================================================
# PRODUCTION — section separee, a ne PAS recopier telle quelle
# =============================================================================
# La pile de production est `docker-compose.prod.yml`, et elle lit un fichier
# DISTINCT, `backend/.env.production` (ignore par git : `.gitignore` ligne 50,
# `.env.*`, que la ligne 51 ne retablit que pour le present fichier).
#
#     cd backend
#     cp .env.example .env.production     # puis remplir, section par section
#
# Les deux fichiers restent etanches a dessein : `docker-compose.prod.yml` lit
# `.env.production` via `--env-file`, et jamais `backend/.env`, qui porte la
# vraie chaine Neon. Melanger les deux, c'est le jour ou une commande de
# production part sur la base de developpement.
#
# Les valeurs ci-dessous sont celles qui CHANGENT en production. Tout le reste
# (base de donnees, JWT, courriel, limites) se remplit comme plus haut, avec des
# valeurs reelles.
# -----------------------------------------------------------------------------

# --- Bot Telegram : nom du bot ----------------------------------------------
# Utilise UNIQUEMENT pour construire les liens profonds (`https://t.me/<nom>?...`)
# et les textes d'aide. Ce n'est PAS un identifiant d'authentification : le bot
# vit dans n8n, et c'est la-bas que se trouve le token Telegram reel
# (`TELEGRAM_BOT_TOKEN` du workflow). Rien ici ne permet d'agir au nom du bot.
#
# Sans valeur, le nom par defaut est employe. Un nom faux ne casse aucune
# authentication : il casse les LIENS, c'est-a-dire que l'utilisateur clique et
# arrive sur « bot introuvable » — une panne invisible cote serveur, donc difficile
# a diagnostiquer sans cette variable sous les yeux.
TELEGRAM_BOT_USERNAME=ComexaWork_bot

# --- Transcription des vocaux Telegram --------------------------------------
# `POST /api/v1/integrations/telegram/transcribe` rend le texte d'un vocal.
# Le bot n8n telecharge le fichier depuis Telegram (`getFile`) et le transmet ici :
# le backend ne parle JAMAIS a Telegram, et aucun octet audio n'est conserve.
#
# UN SEUL MOTEUR, PLUSIEURS FOURNISSEURS. L'API `/audio/transcriptions` d'OpenAI
# est devenue une forme commune : Groq, OpenAI, Mistral et un Whisper
# auto-heberge la servent tous. Changer de fournisseur est donc une URL, pas une
# dependance.
#
# AUCUN FFMPEG N'EST NECESSAIRE : un vocal Telegram est de l'Opus dans un
# conteneur OGG, et c'est un format que ces moteurs acceptent directement.
TRANSCRIPTION_PROVIDER=none
# Racine SANS le chemin : `/audio/transcriptions` est ajoute par le code.
#   Groq   : https://api.groq.com/openai/v1        (palier gratuit, le plus rapide)
#   OpenAI : https://api.openai.com/v1
#   Local  : http://whisper:8000/v1                (serveur faster-whisper)
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
# Modele attendu par le fournisseur ci-dessus. Groq sert les deux valeurs
# ci-dessous ; OpenAI sert `whisper-1`. Un modele inconnu chez le fournisseur
# repond souvent 200 SANS texte — d'ou le refus explicite cote backend.
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Langue forcee. LAISSER VIDE pour que le moteur detecte : sur une equipe qui
# parle francais ET arabe, imposer `fr` fait transcrire un vocal arabe n'importe
# comment, sans aucune erreur nulle part.
TRANSCRIPTION_LANGUAGE=
# Amorce de decodage : vocabulaire attendu (noms propres, termes metier). Ce
# n'est PAS une consigne — un moteur de transcription ne repond pas, il transcrit.
TRANSCRIPTION_PROMPT=Comexa, devis, facture, Algerie
# Taille maximale d'un vocal, en octets (20 Mo par defaut). Un vocal Telegram
# depasse rarement 1 Mo par minute : au-dela, ce n'est vraisemblablement pas un
# vocal, et l'appel au moteur est facture meme quand il echoue.
TRANSCRIPTION_MAX_BYTES=20971520
# Delai d'attente du moteur, en millisecondes.
TRANSCRIPTION_TIMEOUT_MS=60000
# Duree de conservation du TEXTE transcrit, en jours. 0 = conserver indefiniment.
# Une purge automatique n'est pas activee par defaut : effacer des traces sans
# qu'on l'ait demande serait pire que les conserver.
TRANSCRIPT_RETENTION_DAYS=30

# --- Passerelle WhatsApp ----------------------------------------------------
# Permet d'envoyer des messages DEPUIS le compte WhatsApp d'un membre, ou depuis
# celui d'un tiers qui l'a autorise. Le backend ne parle pas WhatsApp lui-meme :
# il appelle une passerelle auto-hebergee qui tient la session multidevice.
#
# AVERTISSEMENT, A LIRE AVANT DE RENSEIGNER AUTRE CHOSE QUE `none` :
#   - aucune API OFFICIELLE de WhatsApp ne donne acces a un compte personnel et a
#     son repertoire. L'API Business Cloud exige un numero d'entreprise dedie, ne
#     donne pas le carnet d'adresses, et impose des modeles pre-approuves hors de
#     la fenetre de 24 heures ;
#   - connecter un compte personnel a un automate est CONTRAIRE AUX CONDITIONS
#     D'UTILISATION de WhatsApp et peut entrainer la suspension DEFINITIVE du
#     numero. C'est ecrit dans le texte de consentement montre au titulaire ;
#   - d'ou les garde-fous imposes par le code : consentement versionne et revoquable
#     a tout instant, plafond d'envois par heure et par compte, journal de chaque
#     envoi, interdiction des groupes, suppression des contacts copies a la
#     revocation.
WHATSAPP_GATEWAY_DRIVER=none
#   waha      : https://github.com/devlikeapro/waha — UNE instance tient plusieurs
#               sessions, c'est la forme du besoin ici (un membre = une session).
#               Le repertoire (`/api/contacts/all`) fait partie de WAHA PLUS : sans
#               cette licence, les envois restent possibles vers un numero connu.
#   evolution : https://github.com/EvolutionAPI/evolution-api — une INSTANCE par
#               compte, donc un conteneur par numero.
#   none      : les routes existent et repondent 503 avec un code stable.
#
# URL et cle sont OBLIGATOIRES des que le pilote n'est pas `none` : le serveur
# refuse de demarrer sinon, parce qu'une passerelle mal configuree ne se voit
# qu'au premier envoi — donc chez un client.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=
# En production, une URL en `http://` est refusee, SAUF vers un hote interne
# (conteneur du meme reseau). La cle d'API circule en clair sinon.
WHATSAPP_GATEWAY_TIMEOUT_MS=20000
# Prefixe des noms de session cote passerelle. Le nom complet est
# `<prefixe>-<alea>` : il ne contient JAMAIS l'identifiant d'un membre, parce
# qu'il apparait dans les journaux de la passerelle, qui est un service distinct.
WHATSAPP_SESSION_PREFIX=comexa
# Plafond d'envois par heure GLISSANTE et par compte. Borne le risque de
# bannissement sans le supprimer. Un refus rend `WHATSAPP_RATE_LIMITED` (429) :
# la meme demande reussira plus tard, ce que le noeud Retry de n8n comprend.
WHATSAPP_MAX_MESSAGES_PER_HOUR=40
# Longueur maximale d'un corps de message. Un message trop long est REFUSE, pas
# tronque : tronquer changerait son sens sans que le destinataire le voie.
WHATSAPP_MAX_BODY_LENGTH=1024
# Duree de validite du code d'autorisation remis a un tiers (`WA-XXXX-XXXX-XXXX`).
# Au-dela, le code est mort et il faut en demander un autre.
WHATSAPP_DELEGATION_CODE_TTL=72h
# Duree de validite du consentement lui-meme. VIDE = aucune echeance : le
# consentement reste valable jusqu'a revocation. Une duree force un renouvellement
# periodique, utile si les tiers changent de numero.
WHATSAPP_CONSENT_TTL=
# Fraicheur du cache d'etat de session, en millisecondes. Une page de vingt
# comptes ne doit pas interroger la passerelle vingt fois.
WHATSAPP_SESSION_CACHE_MS=5000
# Fraicheur du cache de repertoire, en minutes. `?refresh=true` sur la route des
# contacts force une resynchronisation.
WHATSAPP_CONTACT_CACHE_MINUTES=30
# Indicatif pays par defaut, applique a un numero saisi en format local
# (`0555123456`). Un numero AMBIGU (ni `+`, ni `00`, ni `0` initial, et ne
# commencant pas par cet indicatif) est REFUSE : deviner enverrait le message
# d'un client a un inconnu.
WHATSAPP_DEFAULT_COUNTRY_CODE=DZ

# --- Reverse proxy (uniquement pour docker-compose.prod.yml) -----------------
# Nom de domaine de l'API. Caddy demande un certificat Let's Encrypt pour ce nom
# exact : il doit deja resoudre vers la machine AVANT le premier demarrage, sans
# quoi l'echec est immediat et le site reste injoignable.
API_DOMAIN=api.exemple.tld
# Adresse de contact ACME. Let's Encrypt y ecrit a 20 jours de l'expiration du
# certificat : c'est le seul avertissement qui precede une panne HTTPS.
ACME_EMAIL=technique@exemple.tld

# --- Ce que `.env.production` doit porter EN PLUS ----------------------------
# AUCUNE VALEUR N'EST RECOPIEE ICI, ET C'EST DELIBERE.
#
# Les variables ci-dessous sont DEJA declarees plus haut dans ce fichier, a leur
# place logique. En production, il faut modifier CES DECLARATIONS-LA :
#
#   NODE_ENV        section « Application »            `development` -> `production`
#   CORS_ORIGIN     section « Application »            -> le domaine du frontend
#   TRUST_PROXY     section « Application »            `false`       -> `1`
#   FRONTEND_URL    section « URL publique du frontend » -> le domaine du frontend
#   STORAGE_DRIVER  section « Stockage des fichiers »  `local`       -> `s3`
#
#   DOCS_ENABLED + DOCS_USER + DOCS_PASSWORD
#                   section « Documentation OpenAPI (production) »
#                   LAISSER `DOCS_ENABLED=false` ferme /api/docs en production —
#                   c'est le defaut voulu. Passer a `true` SEULEMENT pour servir
#                   la documentation en ligne : `DOCS_USER` et `DOCS_PASSWORD`
#                   sont alors EXIGES (16 caracteres minimum pour le mot de
#                   passe), faute de quoi le serveur refuse de demarrer.
#                   La saisie se fait ensuite dans la page de connexion servie
#                   par /api/docs : aucun reglage du navigateur n'est requis.
#
#   Courriel : renseigner L'UN DES DEUX, jamais les deux par precaution.
#   MAILJET_API_KEY + MAILJET_SECRET_KEY
#                   section « 1. MAILJET_API_KEY + MAILJET_SECRET_KEY »
#                   -> les deux cles, copiees depuis « API Key Management ».
#                      A PREFERER : le port 443 n'est jamais filtre.
#   SMTP_HOST       section « 2. SMTP_HOST » -> le relais SMTP. Voir §9 du runbook.
#
# CES VARIABLES SONT CITES PAR LEUR SECTION, JAMAIS PAR UN NUMERO DE LIGNE.
# Une version precedente donnait des numeros, et ils ont derive des le premier
# paragraphe insere dans ce fichier : ils envoyaient le lecteur vers une variable
# sans rapport, ce qui est pire que pas d'indication du tout.
#
# Laisser les deux vides fait REFUSER le demarrage en production : le parcours
# « mot de passe oublie » repondrait 200 sans rien envoyer (voir
# `assertMailConfigured` dans src/config/env.validation.ts).
#
# `API_PREFIX`, `PORT` et les `S3_*` sont identiques ou a remplir sur place, sans
# changer de nom.
#
# POURQUOI PAS DE COPPIE ICI. Une version precedente de ce fichier redeclarait
# ces variables avec leurs valeurs de production, sous ce titre. Comme le runbook
# dit de copier `.env.example` en `.env.production`, le resultat etait un fichier
# a CLES DUPLIQUEES : deux `CORS_ORIGIN`, deux `SMTP_HOST`, deux `NODE_ENV`. Or
# un tel fichier n'a pas de comportement defini — `dotenv` retient la PREMIERE
# occurrence, `docker compose --env-file` la DERNIERE, et l'ecart se regle en
# silence sur une valeur de developpement. Le risque n'etait pas theorique :
# `CORS_ORIGIN` restait sur `http://localhost:3000`, le frontend etait bloque, et
# le serveur demarrait normalement — aucune erreur a se mettre sous la dent.
#
# La regle a retenir : dans `.env.production`, chaque variable apparait UNE SEULE
# FOIS. La section 10 de `docs/DEPLOYMENT.md` le verifie avant le demarrage.

# Cookie de rafraichissement. UNE SEULE VALEUR CORRECTE, SELON L'HEBERGEMENT.
#   lax    : API et frontend sur le MEME domaine parent (`api.exemple.tld` et
#            `www.exemple.tld`). C'est le reglage le plus sur, et celui a
#            preferer quand il est possible.
#   none   : domaines SANS parent commun. C'est le cas si le frontend est
#            heberge sur une plateforme distincte de l'API (Vercel, Netlify...),
#            donc sous un nom que l'API ne partage pas.
#            EXIGE HTTPS : le navigateur refuse `SameSite=None` sans `Secure`,
#            et le serveur pose `Secure` de lui-meme des que NODE_ENV=production.
#
# CE QUE `none` COUTE, ET QU'IL FAUT SAVOIR AVANT DE LE CHOISIR. Un cookie
# `SameSite=None` part sur TOUTE requete vers l'API, y compris declenchee depuis
# un site tiers : la barriere `SameSite` disparait entierement. Le `httpOnly`
# empeche la LECTURE du cookie, jamais son ENVOI. Deux consequences pratiques :
#   - `CORS_ORIGIN` ne doit contenir QUE vos domaines, jamais `*` ;
#   - l'etat de la protection CSRF de ce backend est decrit dans
#     `docs/security-audit.md` — a relire avant de basculer sur `none`.
#
# Sans ce reglage correct, la connexion reussit puis la session disparait au
# premier rechargement de page.
COOKIE_SAMESITE=lax

# --- Stockage des fichiers : profil S3-compatible ----------------------------
# `local` est REFUSE au demarrage en production (voir storage.module.ts) : sur
# le disque d'un conteneur, les fichiers disparaissent au redeploiement alors
# que leurs lignes restent en base.
#
# Les six variables ci-dessous sont les memes pour tout stockage compatible S3 —
# seul le couple endpoint/region change. `S3_FORCE_PATH_STYLE` reste a `true`
# partout ou un sous-domaine `<bucket>.<hote>` ne resout pas.
# AUCUNE DE CES VARIABLES N'EST RECOPIEE ICI : elles sont declarees aux lignes 52
# a 64, et les copier les DUPLIQUERAIT (voir la note ci-dessus). En production,
# modifier sur place :
#
#   STORAGE_DRIVER=local   ->   s3       (`local` est REFUSE au demarrage)
#   S3_*                   ->   les valeurs reelles, §8 du runbook

# Exemples de remplissage, du moins cher au plus souple :
#
#   Backblaze B2 — 10 Go gratuits a vie, SANS carte bancaire.
#     S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#     S3_REGION=us-west-004          (doit correspondre a la region du bucket)
#     S3_ACCESS_KEY_ID=<keyID de la cle d'application>
#     S3_SECRET_ACCESS_KEY=<applicationKey, affichee UNE SEULE fois>
#
#   Oracle Cloud Object Storage — 20 Go sur le palier « Always Free ».
#     S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#     S3_REGION=<region du bucket, ex. eu-paris-1>
#     S3_ACCESS_KEY_ID=<Access Key d'une « Customer Secret Key »>
#     S3_SECRET_ACCESS_KEY=<la Secret Key associee>
#     AVERTISSEMENT : <namespace> est le nom de locataire, PAS votre identifiant
#     de connexion ; et il faut une « Customer Secret Key », pas une cle d'API
#     OCI (`oci_api_key`). Confondre les deux donne une erreur de signature qui
#     ne dit pas laquelle des deux est en cause.
#
#   Cloudflare R2 — 10 Go gratuits, sortie de donnees gratuite, mais une CARTE
#   BANCAIRE est exigee pour activer le service.
#     S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#     S3_REGION=auto
#
# Le bucket doit exister AVANT le premier demarrage : aucun de ces trois
# fournisseurs ne cree un bucket a la volee. Un bucket absent donne une erreur a
# la premiere ecriture, longtemps apres le deploiement.

# --- Courriel : rappel du refus au demarrage ---------------------------------
# Le serveur REFUSE de demarrer en production si ni le couple `MAILJET_API_KEY` +
# `MAILJET_SECRET_KEY` ni `SMTP_HOST` n'est renseigne. Renseigner l'un des deux
# DANS SA SECTION, plus haut — section « 1. MAILJET_API_KEY + MAILJET_SECRET_KEY »
# ou section « 2. SMTP_HOST » — pas ici : les redeclarer les dupliquerait, et la
# derniere valeur lue l'emporterait sans que rien ne le signale.
#
# LES SECTIONS SONT NOMMEES, JAMAIS NUMEROTEES : une reference a un numero de
# ligne devient fausse au premier paragraphe insere, et envoie le lecteur vers
# une variable qui n'a rien a voir.
#
# Pour deployer malgre tout, en sachant que les courriels ne partiront pas :
# ALLOW_BOOT_WITHOUT_MAIL=true, dans la section « Courriel transactionnel ».
