{
  // Configuration de compilation pour L'EXPORT DU DOCUMENT OpenAPI
  // (`npm run openapi:export`, voir `scripts/export-openapi.ts`).
  //
  // POURQUOI UNE CONFIGURATION DEDIEE, ET PAS `tsconfig.json` TEL QUEL.
  //
  // `tsconfig.json` compile `src/` ET `prisma/` — il herite de son `include`,
  // et n'en change que la sortie. Reutiliser sa sortie pour cet export
  // marcherait par accident, mais confondrait deux artefacts : `dist/`
  // appartient a la production (`nest build` le vide a chaque build, voir
  // `deleteOutDir` dans `nest-cli.json`), et un export qui y ecrirait serait
  // casse le jour ou la production viendrait a builder.
  //
  // `include` REMPLACE celui du parent — ce n'est pas un ajout. La liste ne
  // contient donc que ce qui est necessaire : `src/` (l'application) et le seul
  // script d'export. `prisma/` en sort : le seed n'a pas son mot a dire dans
  // le document OpenAPI, et le compiler ici ne ferait qu'allonger la commande.
  //
  // `incremental` est desactive : le `.tsbuildinfo` de la racine decrit la
  // compilation vers `dist/`, et le partager entre deux `outDir` differents
  // produit des compilations partielles silencieusement fausses.
  //
  // CE FICHIER EST COMPILE PAR `nest build -p`, PAS PAR `tsc -p` (voir
  // `openapi:export` dans `package.json`). Ce n'est pas un detail de gout :
  // `nest build` est le seul des deux a appliquer le plugin Swagger de
  // `nest-cli.json`. Ce plugin lit les decorateurs class-validator et recopie
  // leurs bornes dans le schema (`@MaxLength` -> `maxLength`, `@Min` ->
  // `minimum`, `@IsEmail` -> `format: email`), en plus de resoudre le type reel
  // des champs optionnels, la ou `tsc` ecrit `object`.
  //
  // Un export passe par `tsc` ecrirait donc dans `shared/api/openapi.json` un
  // contrat PLUS PAUVRE que celui que `npm run start:dev` sert sur `/api/docs` :
  // mesure, 463 feuilles en moins, 46 valeurs fausses — dont 45 types ecrits
  // `object` — et 67 operations sur 165 concernees.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.export-build",
    "incremental": false
  },
  "include": ["src/**/*.ts", "scripts/export-openapi.ts"]
}
