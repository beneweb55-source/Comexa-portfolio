# =============================================================================
# COMEXA - Configuration d'environnement
# =============================================================================
#
# Ce fichier documente toutes les variables d'environnement disponibles.
# Copiez-le vers .env et adaptez les valeurs selon votre environnement.
#
# IMPORTANT: Ne commitez JAMAIS ce fichier .env dans Git !
#            Il contient des secrets sensibles.
# =============================================================================

# ----------------------------------------------------------------------------
# Environnement
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api

# ----------------------------------------------------------------------------
# Base de données (PostgreSQL)
# ----------------------------------------------------------------------------
# Pour Prisma 7+, la configuration se fait dans prisma.config.ts
# Exemple :
# DATABASE_URL="postgresql://user:password@localhost:5432/comexa?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/comexa?schema=public"

# ----------------------------------------------------------------------------
# CORS - Origines autorisées
# ----------------------------------------------------------------------------
# Séparées par des virgules
CORS_ORIGIN=http://localhost:3000,https://comexa.dz

# ----------------------------------------------------------------------------
# Courriel transactionnel (SMTP ou Mailjet)
# ----------------------------------------------------------------------------
# DEUX OPTIONS POSSIBLES :
# 1. Mailjet API (recommandé pour éviter les problèmes de port)
# 2. SMTP (nécessite que les ports 25, 465 ou 587 soient ouverts)

# Option 1: Mailjet API (recommandé)
# MAILJET_API_KEY=votre_cle_publique
# MAILJET_SECRET_KEY=votre_cle_secrete

# Option 2: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASSWORD=votre-mot-de-passe  # Pour Gmail avec 2FA, utilisez un "App Password"
SMTP_FROM="Comexa <no-reply@comexa.dz>"

# ----------------------------------------------------------------------------
# Génération PDF
# ----------------------------------------------------------------------------
# Ces variables sont optionnelles et permettent de personnaliser les PDF
# générés. Sans elles, les valeurs par défaut seront utilisées.

PDF_COMPANY_NAME=Comexa
PDF_COMPANY_ADDRESS="Adresse de l'entreprise"
PDF_COMPANY_CITY=Algiers
PDF_COMPANY_POSTAL=16000
PDF_COMPANY_COUNTRY=Algérie
PDF_COMPANY_PHONE=+213 123 456 789
PDF_COMPANY_EMAIL=contact@comexa.dz
PDF_COMPANY_WEBSITE=https://comexa.dz
PDF_COMPANY_TAX_ID=TAX123456789
PDF_COMPANY_REGISTRATION=REG123456789

# Chemin vers le logo (optionnel)
# Le logo doit être au format PNG avec fond transparent pour un meilleur rendu
# Si non spécifié, le PDF sera généré sans logo
PDF_LOGO_PATH=public/images/comexa-logo.png

# ----------------------------------------------------------------------------
# Messagerie temps réel (WebSocket)
# ----------------------------------------------------------------------------
# Le backend utilise déjà Socket.IO via @nestjs/platform-socket.io
# Aucune configuration supplémentaire nécessaire pour le backend
# Le frontend utilise socket.io-client, installé avec les dépendances du
# projet : il se connecte au namespace `/rt`.
#
# NEXT_PUBLIC_SOCKET_URL — variable PUBLIQUE, lue par le navigateur.
# Laissez-la VIDE pour que le navigateur passe par le relais Next
# (`/socket.io` -> backend), comme il le fait pour `/api` : c'est le mode de
# repli, celui du développement local.
#
# Renseignez-la en PRODUCTION pour que le navigateur parle DIRECTEMENT au
# backend (ex. `https://api.comexa.tld`) : c'est le seul mode qui donne un
# WebSocket réel derrière un front hébergé ailleurs (Vercel), un relais HTTP
# ne relaieant pas la montée en WebSocket. L'origine du front doit alors
# figurer dans CORS_ORIGIN côté backend — la même liste que celle de l'API.
NEXT_PUBLIC_SOCKET_URL=

# Adresse de l'API utilisée par le relais Next (côté serveur uniquement).
BACKEND_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# Sécurité
# ----------------------------------------------------------------------------
# Secret pour la signature des JWT
JWT_SECRET=votre-secret-tres-long-et-aleatoire-minimum-32-caracteres

# Durée de validité des tokens JWT (en secondes)
JWT_EXPIRES_IN=86400

# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_LIMIT=120
RATE_LIMIT_TTL=60000

# ----------------------------------------------------------------------------
# Stockage (S3 compatible)
# ----------------------------------------------------------------------------
# AWS S3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=votre-access-key
# S3_SECRET_ACCESS_KEY=votre-secret-key
# S3_BUCKET_NAME=votre-bucket

# ----------------------------------------------------------------------------
# Notes de configuration
# ----------------------------------------------------------------------------

# 1. Pour Gmail avec 2FA:
#    - Allez sur https://myaccount.google.com/apppasswords
#    - Sélectionnez "Mail" comme application
#    - Générez un mot de passe
#    - Utilisez ce mot de passe dans SMTP_PASSWORD

# 2. Pour Mailjet:
#    - Créez un compte sur https://www.mailjet.com/
#    - Récupérez votre API Key et Secret Key
#    - Utilisez-les dans MAILJET_API_KEY et MAILJET_SECRET_KEY

# 3. Pour le logo PDF:
#    - Placez votre logo dans public/images/comexa-logo.png
#    - Format recommandé: PNG avec fond transparent
#    - Taille recommandée: 150x50px (sera redimensionné automatiquement)

# 4. Pour la base de données:
#    - Créez une base PostgreSQL
#    - Configurez DATABASE_URL et DIRECT_URL dans prisma.config.ts
#    - Exécutez les migrations: npx prisma migrate dev

# 5. Pour le développement:
#    - Copiez ce fichier vers .env
#    - Remplissez les variables nécessaires
#    - Lancez le backend: npm run start:dev
#    - Lancez le frontend: npm run dev

# =============================================================================
