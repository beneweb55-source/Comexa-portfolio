{
  "name": "comexa-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Application desktop Comexa : frontend local embarqué avec cache chiffré hors ligne.",
  "author": "Comexa",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:web": "node build-frontend.cjs",
    "dist": "npm run build:web && electron-builder --publish never",
    "dist:win": "npm run build:web && electron-builder --win --publish never",
    "dist:mac": "npm run build:web && electron-builder --mac --publish never",
    "dist:linux": "npm run build:web && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dz.comexa.desktop",
    "productName": "Comexa",
    "copyright": "Copyright © 2026 Comexa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline-store.js",
      "config.js",
      "offline.html",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Comexa"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "sql.js": "^1.15.1"
  }
}
